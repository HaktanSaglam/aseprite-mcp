{
  "name": "aseprite-mcp-bridge",
  "version": "1.0.0",
  "description": "Bridge between Aseprite and Claude via MCP",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "aseprite-mcp": "bin/aseprite-mcp.js"
  },
  "files": [
    "bin/",
    "dist/",
    "!dist/**/*.map"
  ],
  "keywords": [
    "aseprite",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "pixel-art",
    "sprite",
    "animation",
    "claude",
    "ai",
    "gamedev"
  ],
  "homepage": "https://github.com/HaktanSaglam/aseprite-mcp#readme",
  "bugs": {
    "url": "https://github.com/HaktanSaglam/aseprite-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaktanSaglam/aseprite-mcp.git",
    "directory": "bridge"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "cross-spawn": "^7.0.6",
    "pngjs": "^7.0.0",
    "quickjs-emscripten": "^0.32.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
